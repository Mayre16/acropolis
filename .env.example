# Copia a .env.local para desarrollo o pásalas al build de producción.
# Ver docs/ANALYTICS-SEO.md

# URL pública del sitio (build cPanel)
NEXT_PUBLIC_SITE_URL=https://acropolis.adesa.com.do

# Google Analytics 4 — ID de medición (Admin → Flujos de datos → Web → ID G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console — meta verification (Propiedad → Verificación → Etiqueta HTML → content="...")
# NEXT_PUBLIC_GSC_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# WhatsApp Business API — Envío automático de frases del día
# ============================================================================
# Para configurar:
# 1. Crea una cuenta en Meta for Developers: https://developers.facebook.com/
# 2. Crea una aplicación de tipo Business
# 3. Agrega el producto WhatsApp
# 4. Obtén el Phone Number ID y Access Token del panel de WhatsApp
#
# WHATSAPP_BUSINESS_PHONE_NUMBER_ID=1234567890
# WHATSAPP_BUSINESS_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx
# WHATSAPP_API_VERSION=v18.0
#
# Opcional: Nombre del template pre-aprobado para mensajes con imagen
# WHATSAPP_TEMPLATE_NAME=frase_del_dia
#
# Modo de prueba (true = no envía mensajes reales)
# WHATSAPP_DRY_RUN=true
