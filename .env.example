# Copia a .env.local para desarrollo o pásalas al build de producción.
# Ver docs/ANALYTICS-SEO.md

# URL pública del sitio (build cPanel)
NEXT_PUBLIC_SITE_URL=https://acropolis.adesa.com.do

# Google Analytics 4 — ID de medición (Admin → Flujos de datos → Web → ID G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console — meta verification (Propiedad → Verificación → Etiqueta HTML → content="...")
# NEXT_PUBLIC_GSC_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# WhatsApp — Envío automático de frases del día
# ============================================================================
# Hay dos opciones: Twilio (sandbox gratuito) o Meta (producción)

# ----------------------------------------------------------------------------
# OPCIÓN 1: TWILIO SANDBOX (Recomendado para empezar - GRATIS)
# ----------------------------------------------------------------------------
# 1. Crea una cuenta en https://www.twilio.com (gratis, sin tarjeta)
# 2. Ve a Messaging → Try it out → Send a WhatsApp message
# 3. Envía el código de unión al número del sandbox desde tu WhatsApp
# 4. Copia tu Account SID y Auth Token desde la consola de Twilio
#
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ----------------------------------------------------------------------------
# OPCIÓN 2: META WHATSAPP BUSINESS API (Producción)
# ----------------------------------------------------------------------------
# 1. Crea una cuenta en Meta for Developers: https://developers.facebook.com/
# 2. Crea una aplicación de tipo Business
# 3. Agrega el producto WhatsApp
# 4. Obtén el Phone Number ID y Access Token del panel de WhatsApp
#
# WHATSAPP_BUSINESS_PHONE_NUMBER_ID=1234567890
# WHATSAPP_BUSINESS_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx
# WHATSAPP_API_VERSION=v18.0
# WHATSAPP_TEMPLATE_NAME=frase_del_dia

# ----------------------------------------------------------------------------
# OPCIONES COMUNES
# ----------------------------------------------------------------------------
# Forzar proveedor específico (twilio o meta). Por defecto detecta automáticamente.
# WHATSAPP_PROVIDER=twilio

# Modo de prueba (true = no envía mensajes reales, solo simula)
# WHATSAPP_DRY_RUN=true
